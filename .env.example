# ── DB（Neon。ローカルだけで動かすときは pglite:./.pglite） ──
DATABASE_URL=

# ── セッション Cookie の署名鍵（32文字以上） ──
HAISHA_SESSION_SECRET=

# ── Cairn でログイン（OIDC） ──
# issuer は <Cairn の URL>/oidc。クライアントは Cairn の運営者がその段階の Cairn に登録する
CAIRN_OIDC_ISSUER=
CAIRN_OIDC_CLIENT_ID=
CAIRN_OIDC_CLIENT_SECRET=
# 配車さんの公開 URL（コールバックは <この URL>/auth/callback）
HAISHA_APP_URL=http://localhost:3000

# ── Cairn の MCP（山行・部員の読み取り。配車係が発行した read スコープの PAT） ──
CAIRN_MCP_URL=
CAIRN_PAT=
CAIRN_PAT_EXPIRES_AT=

# ── 最初の配車係の Cairn ユーザーID（UUID、カンマ区切り） ──
HAISHA_INITIAL_ADMIN_CAIRN_USER_IDS=

# ── 開発用ログイン（ローカルだけ。本番で 1 にすると起動を止める） ──
HAISHA_DEV_LOGIN=

# ── サーバー用 Google Maps Platform APIキー（サーバーだけで使用） ──
# Geocoding API / Routes API / Places API を有効にしたキー。
# 未設定のとき、開発環境では内蔵の住所辞書で動き、本番ではエラーにする。
GOOGLE_MAPS_API_KEY=

# ── ブラウザ用キー（任意。住所サジェスト＝Maps JavaScript API を使う場合のみ） ──
# HTTPリファラー制限と利用API制限（Maps JavaScript API / Places）を必ず設定してください。
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
